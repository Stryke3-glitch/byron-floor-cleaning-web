---
import { beforeAfter } from '../lib/site';
---
<section class="bg-bg">
  <div class="container-x py-20 md:py-28">
    <div class="max-w-[760px]">
      <div class="eyebrow mb-4">Before &amp; after</div>
      <h2 class="h-display text-[clamp(28px,4vw,44px)] leading-[1.1] tracking-[-0.02em] text-balance">Real floors. Real results.</h2>
      <p class="mt-4 text-[17px] text-muted leading-[1.6] max-w-[640px]">A look at recent jobs. Drag a slider to compare before and after.</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {beforeAfter.map((pair, i) => (
        <figure>
          {pair.kind === 'slider' ? (
            <div
              class="ba-slider relative w-full aspect-[4/3] overflow-hidden rounded border border-line bg-black select-none touch-none"
              data-ba
              tabindex="0"
              role="slider"
              aria-label={`Before and after: ${pair.caption}`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="50"
              style="--ba-pos: 50%;"
            >
              <img
                src={pair.after}
                alt={pair.afterAlt}
                class="absolute inset-0 w-full h-full object-cover"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                width="800"
                height="600"
              />
              <img
                src={pair.before}
                alt={pair.beforeAlt}
                class="ba-before absolute inset-0 w-full h-full object-cover"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                width="800"
                height="600"
              />
              <div class="ba-divider absolute inset-y-0 w-0.5 bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.3)]"></div>
              <div class="ba-handle absolute top-1/2 w-11 h-11 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white border border-line-strong shadow-[0_2px_6px_rgba(0,0,0,0.18)] flex items-center justify-center text-ink">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M9 6l-4 6 4 6M15 6l4 6-4 6"/></svg>
              </div>
              <span class="absolute top-2 left-2 text-[10px] font-semibold uppercase tracking-[0.18em] bg-black/55 text-white px-1.5 py-0.5 rounded-sm pointer-events-none">Before</span>
              <span class="absolute top-2 right-2 text-[10px] font-semibold uppercase tracking-[0.18em] bg-white/85 text-ink px-1.5 py-0.5 rounded-sm pointer-events-none">After</span>
            </div>
          ) : (
            <div class="relative w-full aspect-[4/3] overflow-hidden rounded border border-line bg-black">
              <img
                src={pair.image}
                alt={pair.alt}
                class="absolute inset-0 w-full h-full object-cover"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
              <span class="absolute top-2 right-2 text-[10px] font-semibold uppercase tracking-[0.18em] bg-white/85 text-ink px-1.5 py-0.5 rounded-sm pointer-events-none">After</span>
            </div>
          )}
          <figcaption class="mt-4">
            <div class="font-semibold text-ink text-[15px] leading-[1.4]">{pair.caption}</div>
            <div class="text-muted text-[13px] mt-1">{pair.detail}</div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  [data-ba] .ba-before {
    clip-path: inset(0 calc(100% - var(--ba-pos)) 0 0);
  }
  [data-ba] .ba-divider {
    left: var(--ba-pos);
  }
  [data-ba] .ba-handle {
    left: var(--ba-pos);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const setPos = (pct: number) => {
      const p = Math.max(0, Math.min(100, pct));
      el.style.setProperty('--ba-pos', `${p}%`);
      el.setAttribute('aria-valuenow', String(Math.round(p)));
    };

    let dragging = false;
    const move = (clientX: number) => {
      const r = el.getBoundingClientRect();
      setPos(((clientX - r.left) / r.width) * 100);
    };

    el.addEventListener('pointerdown', (e) => {
      dragging = true;
      el.setPointerCapture(e.pointerId);
      move(e.clientX);
    });
    el.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      move(e.clientX);
    });
    el.addEventListener('pointerup', (e) => {
      dragging = false;
      try { el.releasePointerCapture(e.pointerId); } catch {}
    });
    el.addEventListener('keydown', (e) => {
      const cur = parseFloat((el.getAttribute('aria-valuenow') || '50'));
      if (e.key === 'ArrowLeft') { setPos(cur - 5); e.preventDefault(); }
      if (e.key === 'ArrowRight') { setPos(cur + 5); e.preventDefault(); }
      if (e.key === 'Home') { setPos(0); e.preventDefault(); }
      if (e.key === 'End') { setPos(100); e.preventDefault(); }
    });
  });
</script>
