---
import { site, telHref, smsHref } from '../lib/site';

interface Props {
  embedded?: boolean;
  source?: string;
}
const { embedded = false, source = 'estimate-page' } = Astro.props;

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const fallbackAction = endpoint || '/thanks';

const services = ['Strip & Wax', 'Tile & Grout', 'Vinyl Floor Care', 'Recurring Maintenance', 'One-Time Deep Clean', 'Not sure'];
const floors = ['VCT', 'Tile', 'Vinyl', 'Hardwood', 'Other / Not sure'];
const sources = ['Google search', 'Referral / word of mouth', 'Flyer or business card', 'Drove past a job site', 'Other'];
---
<div data-form-watch class:list={['relative bg-bg border border-line rounded', embedded ? 'p-6 sm:p-8' : 'p-6 sm:p-8']}>
  <form
    id="byron-estimate-form"
    method="post"
    action={fallbackAction}
    data-endpoint={endpoint}
    novalidate
    class="space-y-5"
  >
    <div class="flex items-center gap-2 mb-1 text-[12px] text-accent font-semibold uppercase tracking-[0.16em]">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      We reply within 24 hours
    </div>
    <h3 class="h-display text-[24px] md:text-[26px] tracking-[-0.015em] font-semibold text-ink mb-1.5">Free estimate, no obligation.</h3>
    <p class="text-[14px] text-muted leading-[1.55] !mt-0 mb-6">A few short questions. Takes about a minute.</p>

    <input type="hidden" name="source" value={source} />
    <input type="hidden" name="loadedAt" value="" data-loaded-at />
    {/* Honeypot — must remain empty */}
    <div aria-hidden="true" class="absolute left-[-9999px] opacity-0 h-0 w-0 overflow-hidden" tabindex="-1">
      <label>Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <label class="block">
        <span class="block text-[13px] font-semibold text-ink mb-2">Your name <span class="text-accent">*</span></span>
        <input class="field-input" type="text" name="name" required autocomplete="name" />
      </label>
      <label class="block">
        <span class="block text-[13px] font-semibold text-ink mb-2">Phone <span class="text-accent">*</span></span>
        <input class="field-input" type="tel" name="phone" required autocomplete="tel" inputmode="tel" placeholder="908-555-0100" />
      </label>
    </div>

    <label class="block">
      <span class="block text-[13px] font-semibold text-ink mb-2">Email</span>
      <input class="field-input" type="email" name="email" autocomplete="email" placeholder="you@email.com" />
    </label>

    <label class="block">
      <span class="block text-[13px] font-semibold text-ink mb-2">Service address or city/zip <span class="text-accent">*</span></span>
      <input class="field-input" type="text" name="address" required autocomplete="street-address" placeholder="Plainfield, NJ 07060" />
    </label>

    <fieldset class="block">
      <legend class="block text-[13px] font-semibold text-ink mb-2">Property type</legend>
      <div class="flex flex-wrap gap-2">
        {['Residential', 'Commercial'].map((p) => (
          <label class="inline-flex items-center gap-2 px-3.5 py-2.5 border border-line-strong rounded text-[14px] cursor-pointer transition-colors has-[:checked]:border-ink has-[:checked]:bg-white hover:border-ink">
            <input type="radio" name="propertyType" value={p} class="accent-ink" />
            {p}
          </label>
        ))}
      </div>
    </fieldset>

    <div class="grid sm:grid-cols-2 gap-4">
      <label class="block">
        <span class="block text-[13px] font-semibold text-ink mb-2">Floor type <span class="text-accent">*</span></span>
        <select class="field-input" name="floorType" required>
          <option value="">Select...</option>
          {floors.map((f) => <option value={f}>{f}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="block text-[13px] font-semibold text-ink mb-2">Approx. square footage</span>
        <input class="field-input" type="text" name="sqft" inputmode="numeric" placeholder="It's okay to estimate" />
      </label>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <label class="block">
        <span class="block text-[13px] font-semibold text-ink mb-2">Service needed <span class="text-accent">*</span></span>
        <select class="field-input" name="service" required>
          <option value="">Select...</option>
          {services.map((s) => <option value={s}>{s}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="block text-[13px] font-semibold text-ink mb-2">How did you hear about us?</span>
        <select class="field-input" name="referrer">
          <option value="">Select...</option>
          {sources.map((s) => <option value={s}>{s}</option>)}
        </select>
      </label>
    </div>

    <label class="block">
      <span class="block text-[13px] font-semibold text-ink mb-2">Anything else? <span class="text-muted font-normal">(optional)</span></span>
      <textarea class="field-input min-h-[96px] py-3" name="notes" rows="3" placeholder="Timing, access, condition, anything we should know."></textarea>
    </label>

    <div data-error class="hidden text-[14px] text-[#B23A2B] bg-[#fdecea] border border-[#f4c1ba] rounded p-3"></div>

    <div class="flex flex-wrap items-center gap-4 pt-3">
      <button type="submit" class="btn btn-primary">
        <span data-submit-label>Send my free estimate request</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <span class="text-[13px] text-muted">
        Or call/text <a href={telHref} class="text-ink font-semibold underline-offset-4 hover:underline">{site.phone}</a>
      </span>
    </div>
  </form>

  <div data-success class="hidden text-center py-8">
    <div class="inline-flex w-14 h-14 rounded-full bg-accent text-white items-center justify-center mb-5">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
    </div>
    <h3 class="h-display text-[28px] tracking-[-0.015em] font-semibold text-ink">Got it. Talk soon.</h3>
    <p class="mt-3 text-[15px] text-muted max-w-[480px] mx-auto leading-[1.6]">
      Thanks for reaching out. We will review your request and contact you within 24 hours to schedule a free site visit, where we will give you an honest, accurate quote in person.
    </p>
    <div class="mt-6 inline-flex items-center gap-2 px-4 py-3 border border-line rounded text-[14px] text-ink">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
      Need it sooner? <a href={telHref} class="font-semibold underline-offset-4 hover:underline">Call</a>
      or <a href={smsHref} class="font-semibold underline-offset-4 hover:underline">text {site.phone}</a>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('byron-estimate-form') as HTMLFormElement | null;
  if (form) {
    const wrap = form.parentElement!;
    const success = wrap.querySelector('[data-success]') as HTMLElement;
    const errorBox = form.querySelector('[data-error]') as HTMLElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const submitLabel = form.querySelector('[data-submit-label]') as HTMLElement;
    const loadedAtInput = form.querySelector('[data-loaded-at]') as HTMLInputElement;
    const endpoint = form.dataset.endpoint || '';
    const startedAt = Date.now();
    if (loadedAtInput) loadedAtInput.value = String(startedAt);

    const showError = (msg: string) => {
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    };
    const clearError = () => {
      errorBox.textContent = '';
      errorBox.classList.add('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      // honeypot
      const hp = (form.elements.namedItem('website') as HTMLInputElement | null)?.value;
      if (hp) return;

      // time trap
      if (Date.now() - startedAt < 2000) {
        showError('Please take a moment to fill out the form.');
        return;
      }

      // basic required check
      const required = ['name', 'phone', 'address', 'floorType', 'service'];
      for (const k of required) {
        const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
        if (!el || !el.value.trim()) {
          showError('Please fill in all required fields.');
          el?.focus();
          return;
        }
      }

      if (!endpoint) {
        showError('The form is not configured yet. Please call or text ' + (form.dataset.phone || ''));
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending...';

      try {
        const data = new FormData(form);
        const params = new URLSearchParams();
        data.forEach((v, k) => params.append(k, String(v)));
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString(),
        });
        if (!res.ok) throw new Error('Network response was not ok');
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        submitBtn.disabled = false;
        submitLabel.textContent = 'Send my free estimate request';
        showError('Something went wrong sending your request. Please try again, or call/text us directly.');
      }
    });
  }
</script>
