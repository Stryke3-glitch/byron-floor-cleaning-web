---
import { faq } from '../lib/site';
---
<section class="bg-bg">
  <div class="container-x py-20 md:py-28">
    <div class="max-w-[880px]">
      <div class="eyebrow mb-4">Common questions</div>
      <h2 class="h-display text-[clamp(28px,4vw,44px)] leading-[1.1] tracking-[-0.02em] text-balance">What people ask before booking.</h2>
    </div>
    <div class="mt-10 max-w-[880px] border-t border-line">
      {faq.map((f) => (
        <details class="group border-b border-line">
          <summary class="cursor-pointer list-none flex justify-between items-center gap-4 py-6 font-display text-[19px] md:text-[20px] font-medium tracking-[-0.01em] text-ink hover:text-accent transition-colors">
            <span class="leading-[1.35]">{f.q}</span>
            <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full border border-line-strong text-ink transition-transform duration-200 group-open:rotate-45 group-hover:border-accent">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <div class="pb-6 -mt-1 text-[15px] md:text-[16px] text-muted leading-[1.65] max-w-[760px]">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
