---
import { site, telHref, smsHref } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="bg-surface border-t border-line">
  <div class="container-x py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2 font-display text-[22px] font-semibold tracking-tight text-ink">
          <span class="inline-block w-6 h-6 rounded bg-ink text-white text-[13px] font-bold leading-6 text-center font-sans">B</span>
          {site.brand}
        </div>
        <p class="mt-3 text-[14px] text-muted leading-relaxed max-w-sm">
          NJ floor stripping, waxing, and deep cleaning, backed by {site.experience}. Residential and commercial. Owner-led work, one crew, one standard.
        </p>
      </div>
      <div>
        <div class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted mb-3">Contact</div>
        <ul class="space-y-2 text-[14px] text-ink2">
          <li>
            <a href={telHref} class="inline-flex items-center gap-2 hover:text-ink">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
              Call {site.phone}
            </a>
          </li>
          <li>
            <a href={smsHref} class="inline-flex items-center gap-2 hover:text-ink">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>
              Text {site.phone}
            </a>
          </li>
          <li>
            <a href="/estimate" class="inline-flex items-center gap-2 hover:text-ink">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              Get a free estimate
            </a>
          </li>
        </ul>
      </div>
      <div>
        <div class="text-[12px] font-semibold uppercase tracking-[0.14em] text-muted mb-3">Service area</div>
        <p class="text-[14px] text-ink2 leading-relaxed">
          {site.areaLong}<br />
          {site.hours}<br />
          Overnights and weekends available
        </p>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-line flex flex-wrap justify-between gap-3 text-[12px] text-muted">
      <span>© {year} {site.brand}. {site.domain}</span>
      <span>Floor stripping, waxing &amp; deep cleaning · NJ</span>
    </div>
  </div>
</footer>
