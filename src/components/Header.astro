---
import { site, telHref } from '../lib/site';
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/estimate', label: 'Estimate' },
];
---
<header class="sticky top-0 z-30 bg-bg/95 backdrop-blur-sm border-b border-line">
  <div class="container-x flex items-center gap-6 py-3">
    <a href="/" class="flex items-center gap-2 font-display text-[20px] font-semibold tracking-tight text-ink">
      <span class="inline-block w-6 h-6 rounded bg-ink text-white text-[12px] font-bold leading-6 text-center font-sans">B</span>
      <span class="hidden sm:inline">{site.brand}</span>
      <span class="sm:hidden">Byron</span>
    </a>
    <nav class="hidden md:flex gap-6 ml-2" aria-label="Primary">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'py-1.5 text-[14px] font-medium border-b-2 transition-colors',
            isActive(href) ? 'text-ink border-accent' : 'text-muted border-transparent hover:text-ink',
          ]}
        >{label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-3 sm:gap-4">
      <a href={telHref} class="hidden sm:inline-flex items-center gap-2 text-ink font-semibold text-[14px]" aria-label={`Call ${site.phone}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
        <span>{site.phone}</span>
      </a>
      <a href="/estimate" class="btn btn-primary !py-2.5 !px-4 !min-h-0 text-[13px] sm:text-[14px]">Free Estimate</a>
      <button
        type="button"
        id="byron-menu-btn"
        class="md:hidden p-2 -mr-2 text-ink"
        aria-label="Open menu"
        aria-controls="byron-mobile-menu"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="byron-mobile-menu" class="md:hidden fixed inset-0 z-40 bg-bg p-6 hidden flex-col" hidden>
    <div class="flex justify-between items-center">
      <span class="font-display text-[20px] font-semibold text-ink flex items-center gap-2">
        <span class="inline-block w-6 h-6 rounded bg-ink text-white text-[12px] font-bold leading-6 text-center font-sans">B</span>
        {site.brand}
      </span>
      <button type="button" id="byron-menu-close" class="p-2 text-ink" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6l-12 12"/></svg>
      </button>
    </div>
    <nav class="flex flex-col mt-8" aria-label="Mobile">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="py-4 border-b border-line font-display text-[26px] font-medium text-ink">{label}</a>
      ))}
    </nav>
    <div class="mt-7 flex flex-col gap-3">
      <a href={telHref} class="btn btn-secondary w-full">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
        Call {site.phone}
      </a>
      <a href="/estimate" class="btn btn-primary w-full">Get a Free Estimate</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('byron-menu-btn');
  const close = document.getElementById('byron-menu-close');
  const menu = document.getElementById('byron-mobile-menu');
  if (btn && close && menu) {
    const open = () => {
      menu.hidden = false;
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const shut = () => {
      menu.hidden = true;
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    btn.addEventListener('click', open);
    close.addEventListener('click', shut);
    menu.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement) shut();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) shut();
    });
  }
</script>
