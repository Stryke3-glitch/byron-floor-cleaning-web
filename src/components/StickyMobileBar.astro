---
import { telHref, smsHref } from '../lib/site';
---
<div
  id="byron-sticky-bar"
  class="md:hidden fixed left-3 right-3 bottom-3 z-40 bg-ink text-white rounded-lg flex p-1 gap-1 shadow-[0_8px_24px_rgba(0,0,0,0.18)]"
  data-sticky-bar
>
  <a href={telHref} class="flex-1 flex items-center justify-center gap-2 py-3 text-[13px] font-semibold">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
    Call
  </a>
  <a href={smsHref} class="flex-1 flex items-center justify-center gap-2 py-3 text-[13px] font-semibold">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>
    Text
  </a>
  <a href="/estimate" class="flex-[1.4] flex items-center justify-center gap-2 py-3 rounded-md bg-accent text-white text-[13px] font-semibold">
    Free Estimate
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>
</div>

<script>
  const bar = document.getElementById('byron-sticky-bar');
  if (bar && 'IntersectionObserver' in window) {
    const watch = document.querySelector('[data-form-watch]');
    if (watch) {
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          bar.style.display = 'none';
        } else {
          bar.style.display = '';
        }
      }, { rootMargin: '0px 0px -40% 0px' });
      io.observe(watch);
    }
    document.body.style.paddingBottom = '76px';
  }
</script>
