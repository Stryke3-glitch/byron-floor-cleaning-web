---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import EstimateForm from '../components/EstimateForm.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../lib/site';
import { localBusiness, serviceList } from '../lib/jsonld';

const title = `Floor Stripping, Waxing & Deep Cleaning Services · ${site.brand}`;
const description = 'VCT, tile, and vinyl floor care for offices, schools, stores, and homes throughout New Jersey. One-time and recurring service.';
---
<BaseLayout
  title={title}
  description={description}
  pathname="/services"
  jsonLd={[localBusiness, ...serviceList]}
>
  <Hero
    variant="page"
    eyebrow="Services"
    title="What we work on."
    body="Whether it's one room or an entire building, here's exactly what we do and how we do it."
    showCtas={false}
  />
  <ServicesGrid full />
  <HowItWorks />
  <BeforeAfter />
  <section class="bg-bg">
    <div class="container-x py-16 md:py-24">
      <div class="max-w-[880px] mx-auto">
        <div class="max-w-[760px]">
          <div class="eyebrow mb-4">Get a quote</div>
          <h2 class="h-display text-[clamp(28px,4vw,44px)] leading-[1.1] tracking-tight">Ready for a free estimate?</h2>
          <p class="mt-3.5 text-[17px] text-muted leading-[1.55]">Tell us a bit about the floor. We'll reach out within 24 hours to schedule your free site visit.</p>
        </div>
        <div class="mt-8">
          <EstimateForm embedded source="services" />
        </div>
      </div>
    </div>
  </section>
  <Faq />
  <CtaBand />
</BaseLayout>
